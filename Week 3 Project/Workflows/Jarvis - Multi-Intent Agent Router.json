    {
      "parameters": {
        "jsCode": "const req=$('Validate Request').first().json; const context=($json.matches||[]).map(x=>x.metadata?.text||x.metadata?.content||'').filter(Boolean); const actions=['segment_customers','assess_churn_risk','select_campaign_audience','draft_reengagement_email','draft_cross_sell_email']; const schema={type:'object',properties:{run_sales:{type:'boolean'},sales_task:{type:'string'},run_customer:{type:'boolean'},customer_task:{type:'string'},customer_actions:{type:'array',items:{type:'string',enum:actions}},forecast_months:{type:'integer',minimum:1,maximum:12},product_subcategory:{type:'string'},purchase_period:{type:'string',enum:['none','last_completed_quarter','last_90_days','all_history']},promotion_category:{type:'string'},customer_key:{type:'integer',minimum:0},top_n:{type:'integer',minimum:1,maximum:100}},required:['run_sales','sales_task','run_customer','customer_task','customer_actions','forecast_months','product_subcategory','purchase_period','promotion_category','customer_key','top_n'],additionalProperties:false}; return [{json:{openaiBody:{model:'gpt-4.1-mini',instructions:'Decompose the request into independent specialist tasks. Enable sales for forecasts, revenue, demand, seasonality, inventory or budget analysis. Enable customer for segmentation, churn, audience selection, re-engagement or cross-sell email drafting. Enable BOTH for overlapping requests. Preserve product and time filters. Use last_completed_quarter for phrases like last quarter. Never invent a promotion category. Return empty strings when unspecified. Customer actions must include every requested operation.',input:`Request: ${req.message}\\nRetrieved guidance:\\n${context.join('\\n')}`,text:{format:{type:'json_schema',name:'multi_agent_route',strict:true,schema}},store:false}}}];"
