      "parameters": {
        "jsCode": "const req=$('Validate Request').first().json; const text=($json.output||[]).flatMap(i=>i.content||[]).find(c=>c.type==='output_text')?.text; if(!text) throw new Error('Router returned no output_text'); const r=JSON.parse(text); const message=req.message; const salesIntent=/\\b(forecast|forecasting|revenue|seasonal|seasonality|sales trend|demand|inventory|budget)\\b/i.test(message); const customerIntent=/\\b(customer|customers|churn|at-risk|inactive|segment|segmentation|campaign|audience|re-engagement|cross-sell|promotional email|email)\\b/i.test(message); r.run_sales=Boolean(r.run_sales||salesIntent); r.run_customer=Boolean(r.run_customer||customerIntent); const actions=new Set(Array.isArray(r.customer_actions)?r.customer_actions:[]); if(/\\b(at-risk|churn)\\b/i.test(message)) actions.add('assess_churn_risk'); if(/\\bsegment|segmentation\\b/i.test(message)) actions.add('segment_customers'); if(/\\b(audience|customers? who|purchased).*(campaign|email|sale)|campaign audience\\b/i.test(message)) actions.add('select_campaign_audience'); if(/re-engagement email/i.test(message)) actions.add('draft_reengagement_email'); if(/cross-sell|promotional email|accessor(?:y|ies) sale/i.test(message)) actions.add('draft_cross_sell_email'); r.customer_actions=[...actions]; if(r.run_sales&&!r.sales_task) r.sales_task=message; if(r.run_customer&&!r.customer_task) r.customer_task=message; if(!r.run_sales&&!r.run_customer) throw new Error('Request did not match either specialist'); \nconst invalidSubcategory =\n  /^(internet|reseller|internet\\s+and\\s+reseller|reseller\\s+and\\s+internet|both channels)$/i;\n\nif (invalidSubcategory.test(String(r.product_subcategory || '').trim())) {\n  r.product_subcategory = '';\n}\nreturn [{json:{...req,...r,forecast_months:r.forecast_months||req.forecast_months,customer_key:r.customer_key||req.customer_key,top_n:r.top_n||req.top_n}}];"
      },
